# Shared ThorVG packaging config. Source from platform scripts.
# Override on the command line: THORVG_TAG=v1.2.0 ./apple/scripts/build_frameworks.sh

THORVG_TAG="${THORVG_TAG:-v1.1.0}"
THORVG_GIT_URL="${THORVG_GIT_URL:-https://github.com/thorvg/thorvg.git}"

# Resolved by callers after REPO_ROOT is known:
#   THORVG_DIR="${THORVG_DIR:-$REPO_ROOT/third_party/thorvg}"
