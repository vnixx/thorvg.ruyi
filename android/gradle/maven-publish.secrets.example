# Copy the relevant keys into ~/.gradle/gradle.properties (NOT this repo).
#   mkdir -p ~/.gradle
#   # append the lines below after filling in real values
#
# Never commit real tokens or private keys.

# Central Portal user token (Account → Generate User Token)
# NOT your Sonatype login password.
mavenCentralUsername=
mavenCentralPassword=

# GPG signing (pick ONE style)

# Style A — classic secring (local machine)
# signing.keyId=XXXXXXXX          # last 8 hex chars of key id
# signing.password=               # GPG passphrase
# signing.secretKeyRingFile=/Users/YOU/.gnupg/secring.gpg

# Style B — in-memory armored key (good for CI / modern gpg without secring)
# Export with: gpg --export-secret-keys --armor <KEYID>
# Paste the whole block as a single line, or use \n escapes / Gradle env vars.
# signingInMemoryKey=-----BEGIN PGP PRIVATE KEY BLOCK-----...
# signingInMemoryKeyId=XXXXXXXX
# signingInMemoryKeyPassword=
